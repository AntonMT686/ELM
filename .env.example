# ---- ADA-ELM configuration --------------------------------------------------------------------
# Copy to .env in the repository root (the setup script does this for you). Never commit .env.
# Read by the backend, the worker and the frontend server. Restart them after a change.

# dev  = tables are created/upgraded and seeded automatically when the backend starts
# uat / prod = run `python -m app.dbsetup` yourself once per release (the setup/start scripts do it)
ELM_ENVIRONMENT=uat
# Demo org/users/projects (fictional, generic names). Set false for production: only `admin` is created.
ELM_SEED_DEMO_DATA=true
# Password for `admin` when ELM_SEED_DEMO_DATA=false (first start only)
ELM_ADMIN_PASSWORD=change-me-admin-password
# Long random string used to sign session cookies. The setup script generates one.
ELM_SECRET_KEY=change-me-64-random-chars-for-session-signing-xxxxxxxxxxxxxxxxxxxxxxxx
# true only when ELM is served over HTTPS
ELM_COOKIE_SECURE=false

# ---- Database: the existing MySQL / MariaDB database proflow_uat ------------------------------
# ELM creates its own tables there, all named elm_*; the legacy PMS tables are never changed.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/proflow_uat?charset=utf8mb4
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, : -> %3A).
ELM_DATABASE_URL=mysql+pymysql://elm:change-me-db-password@127.0.0.1:3309/proflow_uat?charset=utf8mb4

# ---- Files (relative paths are under the repository folder) ----------------------------------
ELM_STORAGE_DIR=data/storage
ELM_PKI_DIR=data/pki
ELM_MAX_UPLOAD_MB=200

# ---- Ports ------------------------------------------------------------------------------------
# Backend API (FastAPI / uvicorn). Must be reachable from the OnlyOffice container.
ELM_API_HOST=0.0.0.0
ELM_API_PORT=8000
# Frontend web server. Users open http://<server>:<ELM_WEB_PORT>
ELM_WEB_HOST=0.0.0.0
ELM_WEB_PORT=8088
# Where the frontend server forwards /api requests (the backend above)
ELM_API_URL=http://127.0.0.1:8000
# Show demo accounts on the login page: 1 = yes (demo), 0 = no (production). Rebuild the frontend after changing.
VITE_DEMO_HINT=1

# ---- OnlyOffice Document Server (the only part that runs in Docker) ---------------------------
ELM_ONLYOFFICE_ENABLED=true
# URL the BROWSER uses to load the editor (host port of the OnlyOffice container)
ELM_ONLYOFFICE_PUBLIC_URL=http://localhost:8080
# URL the BACKEND uses to download saved files from OnlyOffice
ELM_ONLYOFFICE_INTERNAL_URL=http://localhost:8080
# Must equal the JWT secret of the Document Server
ELM_ONLYOFFICE_JWT_SECRET=your-onlyoffice-jwt-secret
# URL the OnlyOffice CONTAINER uses to reach the backend running on this host.
# Docker Desktop (Windows): host.docker.internal works. Linux Docker: use the host's LAN IP.
ELM_BACKEND_INTERNAL_URL=http://host.docker.internal:8000

# ---- GitLab (self-hosted, already running in Docker) -----------------------------------------
ELM_GITLAB_ENABLED=false
# URL the backend uses for the GitLab API (the GitLab container's published HTTP port)
ELM_GITLAB_URL=http://localhost:8929
# URL users' browsers use for GitLab links (leave empty = same as ELM_GITLAB_URL)
ELM_GITLAB_PUBLIC_URL=
# Access token with `api` scope (GitLab > User / Group settings > Access tokens). Kept server-side only.
ELM_GITLAB_TOKEN=
# Secret token you also type into each GitLab project webhook (Settings > Webhooks > Secret token)
ELM_GITLAB_WEBHOOK_SECRET=

# ---- Digital signature provider (DEV ONLY; ADA PKI/HSM adapter TBD) --------------------------
ELM_SIGNATURE_PROVIDER=dev_local_ca
ELM_WORKER_INTERVAL_SECONDS=900

# ---- draw.io diagram editor (optional, intranet) ----------------------------------------------
# URL of a self-hosted draw.io (e.g. the jgraph/drawio container, or its static webapp folder on any web server).
# Empty = no embedded editor; diagrams are uploaded as .drawio / .svg / .png files instead.
ELM_DRAWIO_URL=

# ---- Test automation runners (optional) -------------------------------------------------------
# Tool names whose runners may claim automated test jobs, e.g. playwright. Empty = automated jobs fail clearly.
ELM_TEST_RUNNERS=
# Token the runners send in X-ELM-Runner-Token
ELM_TEST_RESULTS_TOKEN=

# ---- Software deployment (architecture §14) ---------------------------------------------------
# Folder with the approved deployment scripts (script adapter). Only files directly in this folder can be named
# in an environment configuration; nothing from the browser is ever run.
ELM_DEPLOY_SCRIPTS_DIR=
ELM_DEPLOY_SCRIPT_TIMEOUT_SECONDS=1800
# Waiting attempts (manual / pipeline) fail after this many hours without a result
ELM_DEPLOY_TIMEOUT_HOURS=6
# How often the worker processes deployment attempts (seconds)
ELM_DEPLOY_POLL_SECONDS=20
# HMAC key for CI callbacks to /api/v1/deployments/callback (header X-ELM-Signature: sha256=<hex>)
ELM_DEPLOY_CALLBACK_SECRET=
# Deployment secrets named in an environment configuration are read from ELM_DEPLOY_SECRET_<NAME>, e.g.
# ELM_DEPLOY_SECRET_UAT_KEY=...
