# ---- ADA-ELM configuration (copy to .env; never commit real secrets) ----
# dev = auto create tables + demo seed (SQLite allowed); uat/prod = alembic migrations
ELM_ENVIRONMENT=uat
# Demo org/users/projects (fictional). Set false for production.
ELM_SEED_DEMO_DATA=true
# Show demo accounts on the login page (0 in prod). Needs image rebuild.
ELM_DEMO_HINT=1
ELM_DB_PASSWORD=change-me-strong-db-password
ELM_SECRET_KEY=change-me-64-random-chars-for-session-signing-xxxxxxxxxxxxxxxxxxxxxxxx
# true only when ELM is served over HTTPS
ELM_COOKIE_SECURE=false
# Port on which ELM is published on the host -> http://localhost:8088
ELM_HTTP_PORT=8088

# ---- OnlyOffice Document Server (already running in Docker) ----
ELM_ONLYOFFICE_ENABLED=true
# URL the BROWSER uses to load the editor (host port of your OnlyOffice container)
ELM_ONLYOFFICE_PUBLIC_URL=http://localhost:8080
# URL the ELM BACKEND container uses to download saved files from OnlyOffice
ELM_ONLYOFFICE_INTERNAL_URL=http://host.docker.internal:8080
# Must equal the JWT secret of the Document Server
ELM_ONLYOFFICE_JWT_SECRET=your-onlyoffice-jwt-secret
# URL the OnlyOffice container uses to reach ELM (through the web/nginx container)
ELM_BACKEND_INTERNAL_URL=http://host.docker.internal:8088

# ---- Digital signature provider (DEV ONLY; ADA PKI/HSM adapter TBD) ----
ELM_SIGNATURE_PROVIDER=dev_local_ca
ELM_MAX_UPLOAD_MB=200
ELM_WORKER_INTERVAL_SECONDS=900
